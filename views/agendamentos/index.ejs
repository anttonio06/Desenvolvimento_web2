<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Agendamentos - PetAgenda</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/dashboard.css">
  <link rel="stylesheet" href="/css/pages.css">
</head>
<body>

  <%- include('../partials/sidebar') %>

  <main class="main-content">

    <div class="page-header">
      <div>
        <div class="page-title"><i class="bi bi-calendar2-week-fill"></i> Agendamentos</div>
        <div class="page-subtitle">Gerencie todos os agendamentos</div>
      </div>
      <button class="btn-primary-action" onclick="window.location.href='/agendamentos/novo'">
        <i class="bi bi-plus-lg"></i> Novo Agendamento
      </button>
    </div>

    <div class="view-toggle">
      <button class="view-toggle-btn active" id="btn-lista" onclick="toggleView('lista')">
        <i class="bi bi-list-ul"></i> Lista
      </button>
      <button class="view-toggle-btn" id="btn-cal" onclick="toggleView('calendario')">
        <i class="bi bi-calendar3"></i> Calendário
      </button>
    </div>

    <!-- Filtros de status -->
    <div class="filter-bar" id="filter-bar">
      <button class="filter-btn" data-status="todos">Todos</button>
      <button class="filter-btn active" data-status="confirmado">Agendados</button>
      <button class="filter-btn" data-status="concluido">Concluídos</button>
      <button class="filter-btn" data-status="cancelado">Cancelados</button>
    </div>

    <div id="list-section">
    <div class="section-card">
      <div class="search-bar">
        <i class="bi bi-search"></i>
        <input type="text" placeholder="Buscar por cliente, pet ou serviço..." id="busca-agendamento">
      </div>

      <table class="table-agendamentos" id="tabela-agendamentos">
        <thead>
          <tr>
            <th>Data / Hora</th>
            <th>Cliente</th>
            <th>Pet</th>
            <th>Serviço</th>
            <th>Funcionário</th>
            <th>Valor</th>
            <th>Status</th>
            <th>Ações</th>
          </tr>
        </thead>
        <tbody>
          <% if (agendamentos.length === 0) { %>
            <tr>
              <td colspan="8">
                <div class="empty-state">
                  <i class="bi bi-calendar2-x"></i>
                  Nenhum agendamento cadastrado ainda.
                </div>
              </td>
            </tr>
          <% } else { %>
            <% agendamentos.forEach(function(a) { %>
              <tr data-status="<%= a.status %>">
                <td><strong><%= new Date(a.data_hora.replace(' ', 'T')).toLocaleDateString('pt-BR') %></strong><br><small style="color:#4a4a62; font-size:0.72rem"><%= new Date(a.data_hora.replace(' ', 'T')).toLocaleTimeString('pt-BR', {hour:'2-digit', minute:'2-digit'}) %></small></td>
                <td><%= a.cliente_nome %></td>
                <td><%= a.pet_nome %></td>
                <td><%= a.servicos_nomes || a.servico_nome || '—' %></td>
                <td><%= a.funcionario_nome || '—' %></td>
                <td><%= a.valor ? 'R$ ' + Number(a.valor).toFixed(2).replace('.', ',') : '—' %></td>
                <td>
                  <% if (a.status === 'confirmado') { %><span class="badge-status badge-confirmado">Agendado</span>
                  <% } else if (a.status === 'pendente') { %><span class="badge-status badge-pendente">Pendente</span>
                  <% } else if (a.status === 'concluido') { %><span class="badge-status badge-concluido">Concluído</span>
                  <% } else { %><span class="badge-status badge-cancelado">Cancelado</span>
                  <% } %>
                </td>
                <td class="acoes">
                  <button class="btn-acao" title="Marcar como concluído" onclick="concluir(<%= a.id %>)"
                    style="background:rgba(16,185,129,0.08);color:#10b981;border:1px solid rgba(16,185,129,0.2);<%- (a.status === 'concluido' || a.status === 'cancelado') ? 'visibility:hidden;pointer-events:none' : '' %>">
                    <i class="bi bi-check-lg"></i>
                  </button>
                  <a href="/agendamentos/<%= a.id %>/editar" class="btn-acao editar" title="Editar"><i class="bi bi-pencil-fill"></i></a>
                  <button class="btn-acao excluir" title="Excluir" onclick="excluir('/agendamentos/<%= a.id %>')"><i class="bi bi-trash-fill"></i></button>
                </td>
              </tr>
            <% }) %>
          <% } %>
        </tbody>
      </table>

      <% if (totalPaginas > 1) { %>
        <div style="display:flex;align-items:center;justify-content:space-between;margin-top:18px;padding-top:14px;border-top:1px solid rgba(255,255,255,0.05);">
          <span style="font-size:0.78rem;color:#4b5563;">
            Mostrando página <%= pagina %> de <%= totalPaginas %> &nbsp;·&nbsp; <%= total %> agendamentos no total
          </span>
          <div style="display:flex;gap:6px;">
            <% if (pagina > 1) { %>
              <a href="/agendamentos?pagina=<%= pagina - 1 %>" style="display:inline-flex;align-items:center;padding:6px 12px;border-radius:8px;background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.07);color:#94a3b8;font-size:0.8rem;text-decoration:none;">
                <i class="bi bi-chevron-left"></i>&nbsp; Anterior
              </a>
            <% } %>
            <% if (pagina < totalPaginas) { %>
              <a href="/agendamentos?pagina=<%= pagina + 1 %>" style="display:inline-flex;align-items:center;padding:6px 12px;border-radius:8px;background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.07);color:#94a3b8;font-size:0.8rem;text-decoration:none;">
                Próxima &nbsp;<i class="bi bi-chevron-right"></i>
              </a>
            <% } %>
          </div>
        </div>
      <% } %>

    </div>
    </div><!-- /list-section -->

    <!-- ============ SEÇÃO CALENDÁRIO ============ -->
    <div id="cal-section" style="display:none">

      <!-- Calendário Mensal -->
      <div class="cal-card">
        <div class="cal-nav">
          <div class="cal-nav-group">
            <button class="cal-nav-btn" onclick="calPrevMonth()" title="Mês anterior"><i class="bi bi-chevron-left"></i></button>
            <div class="cal-title-wrapper">
              <button class="cal-nav-title" id="cal-nav-title" onclick="calTogglePicker(event)">
                Carregando...
                <i class="bi bi-chevron-down" id="cal-picker-chevron" style="font-size:0.6rem;transition:transform 0.18s"></i>
              </button>
              <div class="cal-picker" id="cal-picker" style="display:none"></div>
            </div>
            <button class="cal-nav-btn" onclick="calNextMonth()" title="Próximo mês"><i class="bi bi-chevron-right"></i></button>
          </div>
          <div class="cal-nav-group">
            <button class="cal-today-btn" onclick="calToday()">Hoje</button>
            <div class="cal-legend">
              <div class="cal-legend-item"><div class="cal-legend-dot" style="background:#10b981"></div> Agendado</div>
              <div class="cal-legend-item"><div class="cal-legend-dot" style="background:#818cf8"></div> Concluído</div>
              <div class="cal-legend-item"><div class="cal-legend-dot" style="background:#f87171"></div> Cancelado</div>
              <div class="cal-legend-item"><div class="cal-legend-dot" style="background:#fbbf24"></div> Pendente</div>
            </div>
          </div>
        </div>

        <div class="cal-weekdays">
          <div class="cal-weekday">Dom</div>
          <div class="cal-weekday">Seg</div>
          <div class="cal-weekday">Ter</div>
          <div class="cal-weekday">Qua</div>
          <div class="cal-weekday">Qui</div>
          <div class="cal-weekday">Sex</div>
          <div class="cal-weekday">Sáb</div>
        </div>

        <div class="cal-grid" id="cal-grid">
          <div class="cal-loading" style="grid-column:1/-1;padding:40px;text-align:center;color:#3d4f6a;font-size:0.82rem">
            <i class="bi bi-calendar3"></i> &nbsp;Clique em "Calendário" para carregar
          </div>
        </div>
      </div>

      <!-- Painel do Dia (oculto até clicar em um dia) -->
      <div id="day-panel" style="display:none" class="week-panel"></div>

    </div><!-- /cal-section -->

  </main>

  <!-- Modal Confirmação Exclusão -->
  <div class="modal fade" id="modalConfirmar" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width:420px">
      <div class="modal-content" style="border-radius:14px; border:1px solid rgba(239,68,68,0.2); background:#0f1624">
        <div class="modal-body p-4">
          <div style="display:flex; align-items:center; gap:12px; margin-bottom:14px">
            <div style="width:40px; height:40px; border-radius:10px; background:rgba(239,68,68,0.1); display:flex; align-items:center; justify-content:center; flex-shrink:0">
              <i class="bi bi-exclamation-triangle-fill" style="color:#f87171; font-size:1.1rem"></i>
            </div>
            <h5 style="margin:0; font-size:1rem; font-weight:700; color:#f1f5f9">Confirmar exclusão</h5>
          </div>
          <p style="margin:0; font-size:0.875rem; color:#94a3b8; line-height:1.6">Deseja realmente excluir este agendamento? Esta ação não pode ser desfeita.</p>
        </div>
        <div class="modal-footer border-0 pt-0 px-4 pb-4" style="gap:10px">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" style="flex:1">Cancelar</button>
          <button type="button" class="btn btn-danger" id="btnConfirmarExcluir" style="flex:1">Excluir</button>
        </div>
      </div>
    </div>
  </div>

  <% if (typeof sucesso !== 'undefined' && sucesso) { %>
  <div id="toast-sucesso" style="position:fixed;bottom:28px;right:28px;z-index:9999;display:flex;align-items:center;gap:10px;<%= sucesso === 'excluido' ? 'background:#1a1200;border:1px solid rgba(251,146,60,0.3)' : 'background:#0f1f17;border:1px solid rgba(16,185,129,0.3)' %>;border-radius:12px;padding:14px 18px;box-shadow:0 8px 32px rgba(0,0,0,0.4);min-width:260px;">
    <div style="width:32px;height:32px;border-radius:8px;<%= sucesso === 'excluido' ? 'background:rgba(251,146,60,0.15)' : 'background:rgba(16,185,129,0.15)' %>;display:flex;align-items:center;justify-content:center;flex-shrink:0">
      <i class="bi <%= sucesso === 'excluido' ? 'bi-trash-fill' : 'bi-check-circle-fill' %>" style="color:<%= sucesso === 'excluido' ? '#fb923c' : '#10b981' %>;font-size:1rem"></i>
    </div>
    <span style="font-size:0.875rem;font-weight:500;color:#f1f5f9;">
      <%= sucesso === 'criado' ? 'Agendamento criado com sucesso!' : sucesso === 'concluido' ? 'Serviço finalizado!' : sucesso === 'excluido' ? 'Agendamento excluído com sucesso!' : 'Agendamento atualizado com sucesso!' %>
    </span>
  </div>
  <% } %>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    aplicarFiltros();

    var toast = document.getElementById('toast-sucesso');
    if (toast) {
      setTimeout(function() {
        toast.style.transition = 'opacity 0.4s';
        toast.style.opacity = '0';
        setTimeout(function() { toast.remove(); }, 400);
      }, 3000);
    }

    var _urlExcluir = null;
    var _modalConfirmar = null;

    function aplicarFiltros() {
      var termo = document.getElementById('busca-agendamento').value.toLowerCase();
      var statusAtivo = document.querySelector('.filter-btn.active').dataset.status;
      document.querySelectorAll('#tabela-agendamentos tbody tr[data-status]').forEach(function(tr) {
        var matchStatus = statusAtivo === 'todos' || tr.dataset.status === statusAtivo;
        var matchTermo = !termo || tr.textContent.toLowerCase().includes(termo);
        tr.style.display = (matchStatus && matchTermo) ? '' : 'none';
      });
    }

    document.getElementById('busca-agendamento').addEventListener('input', aplicarFiltros);

    document.querySelectorAll('.filter-btn').forEach(function(btn) {
      btn.addEventListener('click', function() {
        document.querySelectorAll('.filter-btn').forEach(function(b) { b.classList.remove('active'); });
        this.classList.add('active');
        aplicarFiltros();
      });
    });

    function concluir(id) {
      fetch('/agendamentos/' + id + '/concluir', { method: 'POST' })
        .then(function(r) { return r.json(); })
        .then(function(data) { if (data.ok) window.location.href = '/agendamentos?sucesso=concluido'; });
    }

    function excluir(url) {
      _urlExcluir = url;
      _modalConfirmar = new bootstrap.Modal(document.getElementById('modalConfirmar'));
      _modalConfirmar.show();
    }

    document.getElementById('btnConfirmarExcluir').addEventListener('click', function() {
      if (_urlExcluir) {
        fetch(_urlExcluir, { method: 'DELETE' }).then(function() {
          _modalConfirmar.hide();
          location.href = '/agendamentos?sucesso=excluido';
        });
      }
    });

    // ============================================================
    // CALENDÁRIO INTERATIVO
    // ============================================================
    (function() {
      var MESES = ['Janeiro','Fevereiro','Março','Abril','Maio','Junho','Julho','Agosto','Setembro','Outubro','Novembro','Dezembro'];
      var DIAS_FULL = ['Domingo','Segunda-feira','Terça-feira','Quarta-feira','Quinta-feira','Sexta-feira','Sábado'];
      var STATUS_LABEL = { confirmado: 'Agendado', concluido: 'Concluído', cancelado: 'Cancelado', pendente: 'Pendente' };

      var state = {
        year: new Date().getFullYear(),
        month: new Date().getMonth(),
        selectedDate: null,
        monthDados: [],
        loading: false
      };

      var pickerYear = state.year;
      var MESES_CURTO = ['Jan','Fev','Mar','Abr','Mai','Jun','Jul','Ago','Set','Out','Nov','Dez'];

      var todayStr = new Date().toISOString().slice(0, 10);

      function pad2(n) { return String(n).padStart(2, '0'); }

      function dateToStr(d) {
        return d.getFullYear() + '-' + pad2(d.getMonth() + 1) + '-' + pad2(d.getDate());
      }

      function byDate(list, dateStr) {
        return list.filter(function(a) { return (a.data_hora || '').slice(0, 10) === dateStr; });
      }

      async function fetchDados(inicio, fim) {
        try {
          var r = await fetch('/agendamentos/calendario-dados?inicio=' + inicio + '&fim=' + fim);
          var json = await r.json();
          return json.ok ? (json.dados || []) : [];
        } catch(e) { return []; }
      }

      async function loadMonth() {
        state.loading = true;
        renderGrid();
        var inicio = state.year + '-' + pad2(state.month + 1) + '-01';
        var fimDate = new Date(state.year, state.month + 1, 1);
        state.monthDados = await fetchDados(inicio, dateToStr(fimDate));
        state.loading = false;
        renderGrid();
      }

      function renderGrid() {
        var grid = document.getElementById('cal-grid');
        var title = document.getElementById('cal-nav-title');
        if (!grid || !title) return;
        title.textContent = MESES[state.month] + ' ' + state.year;

        if (state.loading) {
          grid.innerHTML = '<div style="grid-column:1/-1;padding:44px;text-align:center;color:#3d4f6a;font-size:0.82rem"><i class="bi bi-arrow-clockwise"></i> Carregando...</div>';
          return;
        }

        var firstWeekDay = new Date(state.year, state.month, 1).getDay();
        var daysInMonth = new Date(state.year, state.month + 1, 0).getDate();
        var daysInPrevMonth = new Date(state.year, state.month, 0).getDate();
        var html = '';

        for (var i = firstWeekDay - 1; i >= 0; i--) {
          var day = daysInPrevMonth - i;
          html += buildDayCell(day, dateToStr(new Date(state.year, state.month - 1, day)), true);
        }
        for (var d = 1; d <= daysInMonth; d++) {
          html += buildDayCell(d, dateToStr(new Date(state.year, state.month, d)), false);
        }
        var total = firstWeekDay + daysInMonth;
        var trailing = total % 7 === 0 ? 0 : 7 - (total % 7);
        for (var d = 1; d <= trailing; d++) {
          html += buildDayCell(d, dateToStr(new Date(state.year, state.month + 1, d)), true);
        }

        grid.innerHTML = html;
        grid.querySelectorAll('.cal-day:not(.other-month)').forEach(function(el) {
          el.addEventListener('click', function() { selectDay(this.dataset.date); });
        });
      }

      function buildDayCell(day, dateStr, other) {
        var appts = byDate(state.monthDados, dateStr);
        var cls = 'cal-day';
        if (other) cls += ' other-month';
        if (dateStr === todayStr) cls += ' today';
        if (dateStr === state.selectedDate) cls += ' selected';
        if (!other && appts.length > 0) cls += ' has-appts';

        var inner = '';
        if (!other && appts.length > 0) {
          var seen = {};
          var dots = '';
          appts.forEach(function(a) {
            var s = a.status || 'confirmado';
            if (!seen[s]) { seen[s] = true; dots += '<div class="cal-dot ' + s + '"></div>'; }
          });
          inner = '<div class="cal-dots"><span class="cal-day-count">' + appts.length + '</span>' + dots + '</div>';
        }

        return '<div class="' + cls + '" data-date="' + dateStr + '">' +
          '<div class="cal-day-num">' + day + '</div>' + inner + '</div>';
      }

      function selectDay(dateStr) {
        state.selectedDate = dateStr;
        renderGrid();

        var appts = byDate(state.monthDados, dateStr).sort(function(a, b) {
          return (a.data_hora || '').localeCompare(b.data_hora || '');
        });

        renderDayPanel(dateStr, appts);
      }

      function renderDayPanel(dateStr, appts) {
        var panel = document.getElementById('day-panel');
        if (!panel) return;
        panel.style.display = 'block';

        var d = new Date(dateStr + 'T00:00:00');
        var dayName = DIAS_FULL[d.getDay()];
        var dayFmt = d.getDate() + ' de ' + MESES[d.getMonth()] + ' de ' + d.getFullYear();
        var count = appts.length;

        var html = '<div class="day-panel-header">' +
          '<div>' +
            '<div class="day-panel-label"><i class="bi bi-calendar-day"></i> ' + dayName + '</div>' +
            '<div class="day-panel-date">' + dayFmt + '</div>' +
          '</div>' +
          '<div style="display:flex;align-items:center;gap:8px">' +
            '<span class="day-panel-count">' + count + ' agendamento' + (count !== 1 ? 's' : '') + '</span>' +
            '<button class="week-close-btn" onclick="calFecharDia()" title="Fechar"><i class="bi bi-x-lg"></i></button>' +
          '</div>' +
        '</div>';

        if (count === 0) {
          html += '<div class="day-panel-empty">' +
            '<i class="bi bi-calendar2-x"></i>' +
            '<span>Nenhum agendamento neste dia</span>' +
          '</div>';
        } else {
          html += '<div class="day-panel-list">';
          appts.forEach(function(a) {
            var hora = (a.data_hora || '').slice(11, 16);
            var status = a.status || 'confirmado';
            var label = STATUS_LABEL[status] || status;
            var valor = a.valor ? 'R$ ' + Number(a.valor).toFixed(2).replace('.', ',') : '';
            html +=
              '<div class="day-appt-item ' + status + '">' +
                '<div class="day-appt-time">' + hora + '</div>' +
                '<div class="day-appt-info">' +
                  '<div class="day-appt-pet">' + (a.pet_nome || '—') + '</div>' +
                  '<div class="day-appt-serv">' + (a.servicos_nomes || '—') + '</div>' +
                  '<div class="day-appt-meta">' + (a.cliente_nome || '—') + (a.funcionario_nome ? ' &middot; ' + a.funcionario_nome : '') + '</div>' +
                '</div>' +
                '<div class="day-appt-right">' +
                  '<span class="badge-status badge-' + status + '">' + label + '</span>' +
                  (valor ? '<div class="day-appt-valor">' + valor + '</div>' : '') +
                '</div>' +
                '<a href="/agendamentos/' + a.id + '/editar" class="btn-acao editar" title="Editar" style="flex-shrink:0"><i class="bi bi-pencil-fill"></i></a>' +
              '</div>';
          });
          html += '</div>';
        }

        panel.innerHTML = html;
        panel.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }

      // Funções globais
      window.calPrevMonth = function() {
        if (state.month === 0) { state.month = 11; state.year--; } else state.month--;
        state.selectedDate = null;
        closePicker();
        document.getElementById('day-panel').style.display = 'none';
        loadMonth();
      };

      window.calNextMonth = function() {
        if (state.month === 11) { state.month = 0; state.year++; } else state.month++;
        state.selectedDate = null;
        closePicker();
        document.getElementById('day-panel').style.display = 'none';
        loadMonth();
      };

      window.calToday = function() {
        var t = new Date();
        state.year = t.getFullYear();
        state.month = t.getMonth();
        state.selectedDate = null;
        closePicker();
        document.getElementById('day-panel').style.display = 'none';
        loadMonth();
      };

      function closePicker() {
        var picker = document.getElementById('cal-picker');
        var chevron = document.getElementById('cal-picker-chevron');
        if (picker) picker.style.display = 'none';
        if (chevron) chevron.style.transform = '';
      }

      function renderPicker() {
        var picker = document.getElementById('cal-picker');
        if (!picker) return;
        var realToday = new Date();
        var html = '<div class="cal-picker-year-row">' +
          '<button class="cal-picker-year-btn" data-py="-1"><i class="bi bi-chevron-left"></i></button>' +
          '<span class="cal-picker-year-label">' + pickerYear + '</span>' +
          '<button class="cal-picker-year-btn" data-py="1"><i class="bi bi-chevron-right"></i></button>' +
        '</div><div class="cal-picker-months">';
        MESES_CURTO.forEach(function(m, i) {
          var isSel = (pickerYear === state.year && i === state.month);
          var isHoje = (pickerYear === realToday.getFullYear() && i === realToday.getMonth());
          var cls = 'cal-picker-month-btn' + (isSel ? ' is-selected' : (isHoje ? ' is-today' : ''));
          html += '<button class="' + cls + '" data-mi="' + i + '">' + m + '</button>';
        });
        picker.innerHTML = html + '</div>';

        picker.querySelectorAll('[data-py]').forEach(function(btn) {
          btn.addEventListener('click', function(e) {
            e.stopPropagation();
            pickerYear += parseInt(this.dataset.py);
            renderPicker();
          });
        });
        picker.querySelectorAll('[data-mi]').forEach(function(btn) {
          btn.addEventListener('click', function(e) {
            e.stopPropagation();
            var month = parseInt(this.dataset.mi);
            state.year = pickerYear;
            state.month = month;
            state.selectedDate = null;
            closePicker();
            document.getElementById('day-panel').style.display = 'none';
            loadMonth();
          });
        });
      }

      window.calTogglePicker = function(e) {
        if (e) e.stopPropagation();
        var picker = document.getElementById('cal-picker');
        var chevron = document.getElementById('cal-picker-chevron');
        if (!picker) return;
        if (picker.style.display === 'none') {
          pickerYear = state.year;
          picker.style.display = 'block';
          renderPicker();
          if (chevron) chevron.style.transform = 'rotate(180deg)';
        } else {
          closePicker();
        }
      };

      document.addEventListener('click', function() {
        var picker = document.getElementById('cal-picker');
        if (picker && picker.style.display !== 'none') closePicker();
      });

      window.calFecharDia = function() {
        state.selectedDate = null;
        document.getElementById('day-panel').style.display = 'none';
        renderGrid();
      };

      window.toggleView = function(view) {
        var calSection = document.getElementById('cal-section');
        var listSection = document.getElementById('list-section');
        var filterBar = document.getElementById('filter-bar');
        var btnLista = document.getElementById('btn-lista');
        var btnCal = document.getElementById('btn-cal');

        if (view === 'calendario') {
          calSection.style.display = 'block';
          listSection.style.display = 'none';
          filterBar.style.display = 'none';
          btnLista.classList.remove('active');
          btnCal.classList.add('active');
          if (state.monthDados.length === 0 && !state.loading) loadMonth();
        } else {
          calSection.style.display = 'none';
          listSection.style.display = 'block';
          filterBar.style.display = 'flex';
          btnLista.classList.add('active');
          btnCal.classList.remove('active');
        }
      };

    })();
  </script>

</body>
</html>
